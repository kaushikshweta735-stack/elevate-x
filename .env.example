# ── Optional: Sanity CMS ─────────────────────────────────────────────
# Leave these blank to use the built-in catalogue in src/data/products.ts.
# Set them in Vercel → Settings → Environment Variables for production.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# ── Optional: order capture endpoint ─────────────────────────────────
# A server-side URL that receives each order (see src/lib/order.ts).
# Never put secrets in VITE_ variables — they ship to the browser.
VITE_ORDERS_ENDPOINT=
